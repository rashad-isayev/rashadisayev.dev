generator client {
  provider = "prisma-client"
  // Generated Prisma types live inside src so the app can import them with path aliases.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  content     String
  category    String        @default("General")
  starCount   Int           @default(0)
  viewCount   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  stars       BlogPostStar[]
  views       BlogPostView[]

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
  @@map("blog_posts")
}

model BlogPostStar {
  id         String   @id @default(cuid())
  postId     String
  visitorKey String
  createdAt  DateTime @default(now())
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorKey])
  @@index([visitorKey])
  @@map("blog_post_stars")
}

model BlogPostView {
  id         String   @id @default(cuid())
  postId     String
  visitorKey String
  createdAt  DateTime @default(now())
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorKey])
  @@index([visitorKey])
  @@map("blog_post_views")
}

// Key/value settings are useful for small site controls that do not need a full model.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
